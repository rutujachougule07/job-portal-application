# Apache Configuration for Hostinger (cPanel / LiteSpeed / Apache)
# Enable URL Rewriting for Single Page Application (SPA) routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow direct execution of PHP files (e.g. create-order.php for Razorpay)
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteRule ^ - [L]

  # Never rewrite missing static assets (images, css, js, fonts) to index.html to avoid CDN 422 errors
  RewriteCond %{REQUEST_URI} \.(png|jpe?g|gif|webp|svg|ico|css|js|woff2?|ttf|eot|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Route all other requests to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching & MIME types
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Never cache HTML index so users always get the latest bundle hashes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache hashed assets aggressively
  <FilesMatch "\.(css|js|woff2|woff|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
